{
  "title": "CI/CD Platform - Pipelines Overview",
  "uid": "platform-cicd-pipelines-overview",
  "tags": ["platform-cicd"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count, namespace)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Running now",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(tekton_pipelines_controller_running_pipelineruns_count{namespace=~\"$tenant\"})", "legendFormat": "running" }
      ]
    },
    {
      "id": 2,
      "title": "Succeeded (24h)",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=~\"$tenant\",status=\"success\"}[24h]))", "legendFormat": "succeeded" }
      ]
    },
    {
      "id": 3,
      "title": "Failed (24h)",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=~\"$tenant\",status=\"failed\"}[24h]))", "legendFormat": "failed" }
      ]
    },
    {
      "id": 4,
      "title": "Success rate (24h)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "value": 0, "color": "red" }, { "value": 0.8, "color": "yellow" }, { "value": 0.95, "color": "green" }
      ] } } },
      "targets": [
        { "expr": "sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=~\"$tenant\",status=\"success\"}[24h])) / sum(increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{namespace=~\"$tenant\"}[24h]))" }
      ]
    },
    {
      "id": 5,
      "title": "Stage duration (p50/p95) - from Tempo spanmetrics",
      "type": "timeseries",
      "description": "Derived from the OTel Collector's spanmetrics connector (observability/otel-collector/values.yaml), bucketed by our own platform.stage span attribute - a cross-check against the per-trace durations visible in pipeline-detail.json, not the primary source (see docs/tracing.md).",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le, platform_stage))", "legendFormat": "p50 {{platform_stage}}" },
        { "expr": "histogram_quantile(0.95, sum(rate(traces_spanmetrics_latency_bucket[5m])) by (le, platform_stage))", "legendFormat": "p95 {{platform_stage}}" }
      ]
    },
    {
      "id": 6,
      "title": "Recent flow runs (click a trace to drill down)",
      "type": "table",
      "description": "One row per build->test->deploy->release flow. Each row is a single Tempo trace spanning every independently-triggered PipelineRun in that flow - see docs/tracing.md. Click a trace ID to open pipeline-detail.json for the per-stage waterfall.",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"platform-cicd\" && name =~ \"^stage:\" }"
        }
      ]
    }
  ]
}
