{
    "title": "CI/CD Variant 1 - Live Mission Control",
    "uid": "platform-cicd-mission-control",
    "description": "Real-time NOC-style view of the whole platform: what's running right now, which tenants are active, and controller health. Designed for a wallboard - big numbers, bar-gauge leaderboards, short time windows. All queries are scoped by the $tenant variable so this stays readable as the number of onboarded tenants grows.",
    "tags": ["platform-cicd", "cicd-variant"],
    "schemaVersion": 39,
    "editable": true,
    "time": { "from": "now-3h", "to": "now" },
    "refresh": "10s",
    "templating": {
        "list": [
            {
                "name": "tenant",
                "type": "query",
                "datasource": { "type": "prometheus", "uid": "prometheus" },
                "query": "label_values(tekton_pipelines_controller_pipelinerun_duration_seconds_count, exported_namespace)",
                "includeAll": true,
                "multi": true
            },
            {
                "name": "traceId",
                "type": "textbox",
                "label": "Selected flow (click a row in the pipeline visualizer)",
                "description": "Populated automatically when you click a Trace ID link in the table below - loads that flow's real waterfall into the panel underneath it. Can also be pasted directly. Defaults to a real trace so the panel below is never blank on first load.",
                "current": { "text": "a2d4ac5979f7d1030b7a27a136668782", "value": "a2d4ac5979f7d1030b7a27a136668782" },
                "query": "a2d4ac5979f7d1030b7a27a136668782"
            }
        ]
    },
    "panels": [
        { "id": 100, "type": "row", "title": "Platform pulse", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
        {
            "id": 1, "type": "gauge", "title": "PipelineRuns running now",
            "description": "Cluster-wide gauge from the Tekton controller itself - not scoped by $tenant (the controller doesn't emit this broken out per tenant).",
            "gridPos": { "x": 0, "y": 1, "w": 6, "h": 6 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "min": 0, "max": 10, "unit": "short",
                "thresholds": { "steps": [ { "value": 0, "color": "blue" }, { "value": 6, "color": "yellow" }, { "value": 9, "color": "red" } ] } } },
            "targets": [ { "expr": "tekton_pipelines_controller_running_pipelineruns", "legendFormat": "running" } ]
        },
        {
            "id": 2, "type": "gauge", "title": "TaskRuns running now",
            "gridPos": { "x": 6, "y": 1, "w": 6, "h": 6 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "min": 0, "max": 20, "unit": "short",
                "thresholds": { "steps": [ { "value": 0, "color": "blue" }, { "value": 12, "color": "yellow" }, { "value": 18, "color": "red" } ] } } },
            "targets": [ { "expr": "tekton_pipelines_controller_running_taskruns", "legendFormat": "running" } ]
        },
        {
            "id": 3, "type": "stat", "title": "Workqueue depth (all reconcilers)",
            "description": "Sum of tekton_pipelines_controller_workqueue_depth across every reconciler queue. Sustained non-zero means the controller is falling behind.",
            "gridPos": { "x": 12, "y": 1, "w": 6, "h": 6 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "unit": "short",
                "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 1, "color": "yellow" }, { "value": 5, "color": "red" } ] } } },
            "targets": [ { "expr": "sum(tekton_pipelines_controller_workqueue_depth)" } ]
        },
        {
            "id": 4, "type": "stat", "title": "Reconcile error rate (5m)",
            "description": "Share of controller reconcile loops (pipelinerun/taskrun/resolutionrequest) that ended success=\"false\" in the last 5 minutes.",
            "gridPos": { "x": 18, "y": 1, "w": 6, "h": 6 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "unit": "percentunit",
                "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 0.05, "color": "yellow" }, { "value": 0.2, "color": "red" } ] } } },
            "targets": [ { "expr": "sum(increase(tekton_pipelines_controller_reconcile_count{success=\"false\"}[5m])) / sum(increase(tekton_pipelines_controller_reconcile_count[5m]))" } ]
        },
        { "id": 104, "type": "row", "title": "Pipeline visualizer", "gridPos": { "x": 0, "y": 7, "w": 24, "h": 1 } },
        {
            "id": 20, "type": "table", "title": "Flow board - every build->test->deploy->release run, real time",
            "description": "One row per flow trace, most recent first. 'Flow status' is a real signal, not a guess: this platform's flow-root span is only sent once, from deploy's finally block, as the LAST thing that happens in a healthy flow (see docs/tracing.md) - so a trace still showing '<root span not yet received>' genuinely means that flow is either still running or stopped short (a stage failed) before deploy finished. Click the small expand arrow on any row to see each stage span Tempo has recorded so far, with its own real duration and status (ok/error) - Tempo's native nested-span view, not a custom build. Click a Trace ID link to load that flow's full waterfall in the panel below.",
            "gridPos": { "x": 0, "y": 8, "w": 24, "h": 11 },
            "datasource": { "type": "tempo", "uid": "tempo" },
            "targets": [ { "queryType": "traceql", "query": "{ .service.name = \"platform-cicd\" && name =~ \"^stage:.*\" } | select(status)", "limit": 20 } ],
            "fieldConfig": {
                "defaults": {},
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "traceID" },
                        "properties": [
                            { "id": "displayName", "value": "Trace" },
                            { "id": "custom.width", "value": 160 },
                            { "id": "links", "value": [
                                { "title": "Load waterfall below", "url": "/d/platform-cicd-mission-control/ci-cd-variant-1-live-mission-control?var-traceId=${__value.raw}&from=now-24h&to=now", "targetBlank": false },
                                { "title": "Open full detail (governance + logs)", "url": "/d/platform-cicd-pipeline-detail/ci-cd-platform-pipeline-run-detail?var-traceId=${__value.raw}&from=now-24h&to=now", "targetBlank": false }
                            ] }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "startTime" },
                        "properties": [ { "id": "displayName", "value": "Started" }, { "id": "custom.width", "value": 200 } ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "traceService" },
                        "properties": [
                            { "id": "displayName", "value": "Flow status" },
                            { "id": "custom.width", "value": 220 },
                            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
                            { "id": "mappings", "value": [
                                { "type": "value", "options": { "<root span not yet received>": { "text": "● running / incomplete", "color": "orange" } } },
                                { "type": "value", "options": { "platform-cicd": { "text": "✓ complete", "color": "green" } } }
                            ] }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "traceName" },
                        "properties": [ { "id": "displayName", "value": "Tenant / App" }, { "id": "custom.width", "value": 260 } ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "traceDuration" },
                        "properties": [
                            { "id": "displayName", "value": "Duration so far" },
                            { "id": "unit", "value": "ms" },
                            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } },
                            { "id": "min", "value": 0 },
                            { "id": "max", "value": 300000 },
                            { "id": "thresholds", "value": { "steps": [ { "value": 0, "color": "blue" }, { "value": 120000, "color": "yellow" }, { "value": 240000, "color": "red" } ] } }
                        ]
                    }
                ]
            }
        },
        {
            "id": 21, "type": "traces", "title": "Selected flow waterfall - each bar is one stage, width = real duration",
            "description": "The closest thing to a live 'progress bar' this platform's telemetry can honestly give: spans are only sent once a stage finishes (see docs/tracing.md - there is no true mid-stage percent-complete signal), so this waterfall shows real, completed stages as they land, not a simulated animation. Click a Trace ID above to load it here.",
            "gridPos": { "x": 0, "y": 19, "w": 24, "h": 11 },
            "datasource": { "type": "tempo", "uid": "tempo" },
            "targets": [ { "query": "${traceId}", "queryType": "traceId" } ]
        },
        { "id": 101, "type": "row", "title": "Live activity, last 15 minutes", "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 } },
        {
            "id": 5, "type": "bargauge", "title": "Runs per tenant (15m)",
            "description": "Every onboarded tenant as one bar - built to stay readable whether there are 3 tenants or 300. Sorted by volume.",
            "gridPos": { "x": 0, "y": 31, "w": 12, "h": 9 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
            "fieldConfig": { "defaults": { "unit": "short", "min": 0,
                "thresholds": { "steps": [ { "value": 0, "color": "blue" } ] } } },
            "targets": [ { "expr": "sum by (exported_namespace) (increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$tenant\"}[15m]))", "legendFormat": "{{exported_namespace}}" } ]
        },
        {
            "id": 6, "type": "bargauge", "title": "Slowest tasks right now (p95, 1h)",
            "description": "Every catalog Task's p95 duration over the last hour, across all tenants and pipelines - the bottleneck leaderboard.",
            "gridPos": { "x": 12, "y": 31, "w": 12, "h": 9 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
            "fieldConfig": { "defaults": { "unit": "s", "min": 0,
                "thresholds": { "steps": [ { "value": 0, "color": "green" }, { "value": 30, "color": "yellow" }, { "value": 90, "color": "red" } ] } } },
            "targets": [ { "expr": "topk(10, histogram_quantile(0.95, sum by (le, task) (rate(tekton_pipelines_controller_taskrun_duration_seconds_bucket{exported_namespace=~\"$tenant\"}[1h]))))", "legendFormat": "{{task}}" } ]
        },
        { "id": 102, "type": "row", "title": "Stage funnel, last 24h", "gridPos": { "x": 0, "y": 40, "w": 24, "h": 1 } },
        {
            "id": 7, "type": "bargauge", "title": "Runs by stage (24h)",
            "description": "Volume through each stage of the fixed superset DAG plus the release-governance checks. A big drop between adjacent stages is worth investigating (either real attrition or a stalled chain - see the stalled-pipeline detector).",
            "gridPos": { "x": 0, "y": 41, "w": 24, "h": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "options": { "displayMode": "lcd", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] } },
            "fieldConfig": { "defaults": { "unit": "short", "min": 0,
                "thresholds": { "steps": [ { "value": 0, "color": "blue" } ] } } },
            "targets": [ { "expr": "sum by (pipeline) (increase(tekton_pipelines_controller_pipelinerun_duration_seconds_count{exported_namespace=~\"$tenant\"}[24h]))", "legendFormat": "{{pipeline}}" } ]
        },
        { "id": 103, "type": "row", "title": "Controller health", "gridPos": { "x": 0, "y": 48, "w": 24, "h": 1 } },
        {
            "id": 9, "type": "timeseries", "title": "Reconcile p99 latency by reconciler",
            "gridPos": { "x": 0, "y": 49, "w": 8, "h": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "unit": "s" } },
            "targets": [ { "expr": "histogram_quantile(0.99, sum by (le, reconciler) (rate(tekton_pipelines_controller_reconcile_latency_bucket[5m])))", "legendFormat": "{{reconciler}}" } ]
        },
        {
            "id": 10, "type": "timeseries", "title": "Workqueue depth over time",
            "gridPos": { "x": 8, "y": 49, "w": 8, "h": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "unit": "short" } },
            "targets": [ { "expr": "sum by (name) (tekton_pipelines_controller_workqueue_depth)", "legendFormat": "{{name}}" } ]
        },
        {
            "id": 11, "type": "timeseries", "title": "Running PipelineRuns / TaskRuns over time",
            "gridPos": { "x": 16, "y": 49, "w": 8, "h": 7 },
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "fieldConfig": { "defaults": { "unit": "short" } },
            "targets": [
                { "expr": "tekton_pipelines_controller_running_pipelineruns", "legendFormat": "pipelineruns" },
                { "expr": "tekton_pipelines_controller_running_taskruns", "legendFormat": "taskruns" }
            ]
        }
    ]
}
