# catalog/lib/build-agents.env
#
# Maps the finite `build.agent` enum in schemas/cicd.schema.json to real build-agent
# image references. This is the single place that mapping lives - Tasks resolve it via
# `resolve-build-agent-image.yaml`, they never hardcode an image per agent name.
# Keep this file's keys in sync with the `build.agent` enum in the schema.

nodejs-18=ghcr.io/platform-cicd/build-agents/nodejs:18
nodejs-20=ghcr.io/platform-cicd/build-agents/nodejs:20
nodejs-22=ghcr.io/platform-cicd/build-agents/nodejs:22
openjdk-17=ghcr.io/platform-cicd/build-agents/openjdk:17
openjdk-21=ghcr.io/platform-cicd/build-agents/openjdk:21
python-3.11=ghcr.io/platform-cicd/build-agents/python:3.11
go-1.22=ghcr.io/platform-cicd/build-agents/go:1.22
