{
  "title": "CI/CD Platform - Release Log",
  "uid": "platform-cicd-release-log",
  "tags": ["platform-cicd"],
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-30d", "to": "now" },
  "description": "One row per confirmed release (approvers, per-gate results, bypass) - see docs/admin/release-log.md. Cluster-mapped releases only (see that doc's 'Known gap' section) - a same-cluster staging deploy will not show up here yet.",
  "templating": {
    "list": [
      {
        "name": "app_name",
        "type": "textbox",
        "label": "App name",
        "description": "Substring match, e.g. checkout-api. Leave blank for all apps.",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "env",
        "type": "textbox",
        "label": "Env",
        "description": "Substring match, e.g. prod. Leave blank for all envs.",
        "current": { "text": "", "value": "" }
      },
      {
        "name": "status",
        "type": "textbox",
        "label": "Status",
        "description": "Substring match against Succeeded/Failed/Error. Leave blank for all.",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Release log",
      "type": "table",
      "description": "Structured metadata (app_namespace/app_name/env/cluster/status/bypass) is filtered directly via the template variables above, no parsing needed - everything else (approvers, per-gate results, PR detail) comes from the log body via `| json`. See docs/admin/release-log.md.",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"platform-cicd\"} | platform_release_log_app_name=~\".*$app_name.*\" | platform_release_log_env=~\".*$env.*\" | platform_release_log_status=~\".*$status.*\" | json"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": false,
              "Line": true,
              "id": true,
              "tsNs": true,
              "labels": true
            },
            "indexByName": {
              "Time": 0,
              "app_name": 1,
              "env": 2,
              "cluster": 3,
              "status": 4,
              "bypass": 5,
              "pr_title": 6,
              "merged_by": 7,
              "approvers": 8,
              "gates": 9,
              "pr_url": 10,
              "git_revision": 11,
              "chain_id": 12
            }
          }
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "Succeeded": { "color": "#1E7E34", "text": "Succeeded" } } },
                  { "type": "value", "options": { "Failed": { "color": "#B91C1C", "text": "Failed" } } },
                  { "type": "value", "options": { "Error": { "color": "#B91C1C", "text": "Error" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bypass" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "true": { "color": "#B91C1C", "text": "BYPASSED" } } },
                  { "type": "value", "options": { "false": { "color": "#666666", "text": "" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "pr_url" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "auto" } }]
          }
        ]
      }
    },
    {
      "id": 2,
      "title": "Break-glass merges (bypass = true)",
      "type": "table",
      "description": "Same underlying records as the table above, filtered to merges that bypassed a failing required gate - the release-log's own view of detect-bypass-merge.yaml's Slack alert, but durable/queryable instead of scrollback. See docs/admin/release.md's 'Break-glass' section.",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=\"platform-cicd\"} | platform_release_log_bypass=\"true\" | json"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": false, "Line": true, "id": true, "tsNs": true, "labels": true },
            "indexByName": {
              "Time": 0,
              "app_name": 1,
              "env": 2,
              "merged_by": 3,
              "gates": 4,
              "pr_url": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "#B91C1C" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "pr_url" },
            "properties": [{ "id": "custom.cellOptions", "value": { "type": "auto" } }]
          }
        ]
      }
    }
  ]
}
